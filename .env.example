APP_NAME=AI Interview System
APP_VERSION=2.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
MLFLOW_PORT=5000
FRONTEND_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:8000"]
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=30

# ── Email / SMTP (password reset) ──
# For Gmail: host=smtp.gmail.com, port=587, user=you@gmail.com,
# password=<16-char App Password from Google Account > Security > App passwords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Interview

CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=3600
VALKEY_URL=redis://valkey:6379/0
REDIS_URL=redis://valkey:6379/0

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_interview

OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-interview-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_INSECURE=true

MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=resume-ner
MLFLOW_ARTIFACT_PATH=artifacts
RUST_ACCELERATION_ENABLED=true

# Code execution sandbox. Backends are tried in the listed order, per language,
# and the first one that can run the language wins; if it fails at run time the
# next one is tried. Local backends come first so common languages stay on this
# host — only what no local toolchain can build (Ruby, PHP, Swift, Haskell,
# Erlang on a typical box) goes out to Judge0.
CODE_EXEC_BACKENDS=docker,subprocess,judge0,piston

# Judge0 is what makes the remaining languages run without Docker. The default
# below is the free public instance: it needs no key, but submitted code LEAVES
# THIS MACHINE and the rate limit is shared. Self-host for real interviews:
#   https://github.com/judge0/judge0   → JUDGE0_URL=http://localhost:2358
# Set JUDGE0_URL= (empty) to turn the backend off.
JUDGE0_URL=https://ce.judge0.com
# JUDGE0_API_KEY=
JUDGE0_TIMEOUT_SECONDS=20

# Piston is off by default: its public API went whitelist-only in Feb 2026 and
# answers 401. Point this at a self-hosted instance and move `piston` to the
# front of CODE_EXEC_BACKENDS to prefer it over the local subprocess backend.
# PISTON_URL=http://piston:2000
PISTON_TIMEOUT_SECONDS=20

CODE_EXEC_RATELIMIT_PER_MINUTE=30

WHISPER_MODEL_SIZE=tiny
TTS_PROVIDER=gtts
TTS_LANGUAGE=en
TTS_CACHE_ENABLED=true
TTS_CACHE_DIR=audio_cache

VITE_API_BASE_URL=http://localhost:8000

# Clerk (frontend) — Vite envDir is the monorepo root, so put this here (not only in frontend/)
# Get the publishable key from https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
