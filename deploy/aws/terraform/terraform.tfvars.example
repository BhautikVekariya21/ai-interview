aws_region         = "ap-south-1"
project_name       = "ai-interview"
environment        = "prod"
cluster_name       = "ai-interview-eks"
kubernetes_version = "1.31"
vpc_cidr           = "10.40.0.0/16"
domain_name        = "interviewer.example.com"
hosted_zone_name   = "example.com"
enable_route53_acm = false
valkey_node_type   = "cache.t4g.small"
valkey_num_cache_clusters = 2
create_app_secrets_manager_secret = true
enable_rds_postgres = false
rds_instance_class  = "db.t4g.micro"
rds_allocated_storage = 20
rds_multi_az = true
create_rds_read_replica = false
rds_read_replica_instance_class = "db.t4g.micro"
enable_opensearch = false
opensearch_instance_type = "t3.small.search"
opensearch_instance_count = 2
enable_msk = false
msk_broker_instance_type = "kafka.t3.small"
msk_number_of_broker_nodes = 3
enable_glue_athena = false

tags = {
  Owner = "platform-team"
}
