BACKEND_IMAGE_REPOSITORY=ghcr.io/owner/ai-interview-backend
FRONTEND_IMAGE_REPOSITORY=ghcr.io/owner/ai-interview-frontend
IMAGE_TAG=latest
NGINX_HTTP_PORT=80
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
LOKI_PORT=3100
PROMTAIL_PORT=9080
ALERTMANAGER_PORT=9093
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
SONARQUBE_PORT=9000

APP_NAME=AI Interview System
APP_VERSION=2.0.0
DEBUG=false
HOST=0.0.0.0
PORT=7860
FRONTEND_BASE_URL=https://interviewer.example.com
ALLOWED_ORIGINS=["https://interviewer.example.com"]

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=30

CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=3600
VALKEY_URL=redis://valkey:6379/0
REDIS_URL=redis://valkey:6379/0

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me-in-prod
MYSQL_DATABASE=ai_interview

OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-interview-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_INSECURE=true

MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=resume-ner
MLFLOW_ARTIFACT_PATH=artifacts
RUST_ACCELERATION_ENABLED=true

WHISPER_MODEL_SIZE=tiny
TTS_PROVIDER=gtts
TTS_LANGUAGE=en
TTS_CACHE_ENABLED=true
TTS_CACHE_DIR=audio_cache
